{
  "manifest_version": 3,
  "name": "Leaf Tabs",
  "version": "1.0.0",
  "description": "A hierarchical tab tree manager: nest tabs by opener relationship, color-code, rename, and unload tabs to save memory.",
  "permissions": ["tabs", "storage", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Leaf Tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
